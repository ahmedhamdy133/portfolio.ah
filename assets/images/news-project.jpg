<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" width="100%" height="100%">
  <defs>
    <linearGradient id="newsBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050d24" />
      <stop offset="50%" stop-color="#091540" />
      <stop offset="100%" stop-color="#121838" />
    </linearGradient>

    <linearGradient id="newsFrameGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34488a" />
      <stop offset="100%" stop-color="#0a122e" />
    </linearGradient>

    <linearGradient id="heroCardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#02569B" />
      <stop offset="50%" stop-color="#0175C2" />
      <stop offset="100%" stop-color="#54C5F8" />
    </linearGradient>

    <linearGradient id="feedCardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="rgba(255, 255, 255, 0.08)" />
      <stop offset="100%" stop-color="rgba(255, 255, 255, 0.02)" />
    </linearGradient>

    <radialGradient id="newsGlow" cx="50%" cy="50%" r="60%">
      <stop offset="0%" stop-color="#54C5F8" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#091540" stop-opacity="0" />
    </radialGradient>

    <filter id="shadowNews" x="-10%" y="-10%" width="120%" height="125%">
      <feDropShadow dx="0" dy="25" stdDeviation="30" flood-color="#000000" flood-opacity="0.6" />
    </filter>
  </defs>

  <rect width="1200" height="800" rx="24" fill="url(#newsBg)" />
  <ellipse cx="750" cy="400" rx="380" ry="340" fill="url(#newsGlow)" />

  <g transform="translate(100, 160)">
    <rect width="180" height="34" rx="17" fill="rgba(84, 197, 248, 0.15)" stroke="#54C5F8" stroke-width="1.5" />
    <text x="90" y="22" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="700" fill="#54C5F8" text-anchor="middle" letter-spacing="1.5">FLUTTER &amp; REST API</text>

    <text x="0" y="85" font-family="'Segoe UI', Roboto, sans-serif" font-size="52" font-weight="800" fill="#FFFFFF">News App</text>
    
    <text x="0" y="130" font-family="'Segoe UI', Roboto, sans-serif" font-size="20" font-weight="400" fill="#B4C6E7">
      Real-Time Structured News Digest
    </text>

    <text x="0" y="180" font-family="'Segoe UI', Roboto, sans-serif" font-size="16" fill="#8FA0C7" width="380">
      <tspan x="0" dy="0">Modern mobile news reader consuming RESTful APIs.</tspan>
      <tspan x="0" dy="26">Delivers categorized articles, search functionality,</tspan>
      <tspan x="0" dy="26">offline caching, and fluid card transitions.</tspan>
    </text>

    <g transform="translate(0, 290)">
      <rect x="0" y="0" width="105" height="38" rx="10" fill="#0d1b46" stroke="#0175C2" stroke-width="1.5" />
      <text x="52" y="24" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#54C5F8" text-anchor="middle">Flutter 3</text>

      <rect x="115" y="0" width="85" height="38" rx="10" fill="#0d1b46" stroke="#0175C2" stroke-width="1.5" />
      <text x="157" y="24" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#54C5F8" text-anchor="middle">Dart</text>

      <rect x="210" y="0" width="115" height="38" rx="10" fill="#0d1b46" stroke="#0175C2" stroke-width="1.5" />
      <text x="267" y="24" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#54C5F8" text-anchor="middle">REST APIs</text>

      <rect x="0" y="50" width="125" height="38" rx="10" fill="#0d1b46" stroke="#0175C2" stroke-width="1.5" />
      <text x="62" y="74" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#54C5F8" text-anchor="middle">Dio &amp; JSON</text>

      <rect x="135" y="50" width="155" height="38" rx="10" fill="#0d1b46" stroke="#0175C2" stroke-width="1.5" />
      <text x="212" y="74" font-family="'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#54C5F8" text-anchor="middle">Offline Caching</text>
    </g>

    <g transform="translate(0, 420)">
      <text x="0" y="0" font-family="'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800" fill="#54C5F8">&lt; 300ms</text>
      <text x="0" y="22" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8FA0C7">Fast API Response</text>

      <text x="130" y="0" font-family="'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800" fill="#54C5F8">Async</text>
      <text x="130" y="22" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8FA0C7">Data Fetching</text>

      <text x="230" y="0" font-family="'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="800" fill="#54C5F8">Zero</text>
      <text x="230" y="22" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8FA0C7">Frame Drops</text>
    </g>
  </g>

  <g transform="translate(680, 80)" filter="url(#shadowNews)">
    <rect width="360" height="640" rx="44" fill="#09132d" stroke="url(#newsFrameGrad)" stroke-width="5" />
    <rect x="14" y="14" width="332" height="612" rx="34" fill="#060c1e" />
    <rect x="110" y="24" width="140" height="24" rx="12" fill="#000000" />
    <circle cx="215" cy="36" r="4.5" fill="#142145" />

    <g transform="translate(36, 68)">
      <text x="0" y="20" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" fill="#54C5F8" letter-spacing="1">DISCOVER</text>
      <text x="0" y="44" font-family="'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="800" fill="#FFFFFF">Daily News Pulse</text>
      <circle cx="270" cy="30" r="18" fill="rgba(84, 197, 248, 0.15)" stroke="#54C5F8" stroke-width="1.5" />
      <circle cx="268" cy="28" r="6" fill="none" stroke="#54C5F8" stroke-width="1.8" />
      <line x1="272" y1="32" x2="277" y2="37" stroke="#54C5F8" stroke-width="1.8" stroke-linecap="round" />
    </g>

    <g transform="translate(36, 125)">
      <rect x="0" y="0" width="75" height="30" rx="15" fill="#54C5F8" />
      <text x="37" y="20" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="700" fill="#091540" text-anchor="middle">All Tech</text>

      <rect x="85" y="0" width="60" height="30" rx="15" fill="rgba(255, 255, 255, 0.08)" />
      <text x="115" y="20" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#B4C6E7" text-anchor="middle">Flutter</text>

      <rect x="155" y="0" width="60" height="30" rx="15" fill="rgba(255, 255, 255, 0.08)" />
      <text x="185" y="20" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#B4C6E7" text-anchor="middle">Android</text>

      <rect x="225" y="0" width="60" height="30" rx="15" fill="rgba(255, 255, 255, 0.08)" />
      <text x="255" y="20" font-family="'Segoe UI', Roboto, sans-serif" font-size="12" font-weight="600" fill="#B4C6E7" text-anchor="middle">AI &amp; ML</text>
    </g>

    <g transform="translate(36, 175)">
      <rect width="288" height="155" rx="18" fill="url(#heroCardGrad)" />
      <path d="M 0 90 Q 80 50 160 80 T 288 60 L 288 155 L 0 155 Z" fill="rgba(9, 21, 64, 0.4)" />
      <rect x="16" y="16" width="90" height="24" rx="8" fill="#FF4757" />
      <text x="61" y="32" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="800" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">BREAKING NEWS</text>

      <text x="16" y="70" font-family="'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="800" fill="#FFFFFF">
        <tspan x="16" dy="0">Flutter 3.x Boosts Mobile UI</tspan>
        <tspan x="16" dy="20">Performance &amp; Impeller Engine</tspan>
      </text>

      <text x="16" y="132" font-family="'Segoe UI', Roboto, sans-serif" font-size="11" font-weight="600" fill="#DCE7FA">
        Tech Radar • 12 mins ago
      </text>
    </g>

    <g transform="translate(36, 345)">
      <rect width="288" height="85" rx="14" fill="url(#feedCardGrad)" stroke="rgba(84, 197, 248, 0.2)" stroke-width="1" />
      <rect x="12" y="12" width="60" height="60" rx="10" fill="#14285b" stroke="#0175C2" stroke-width="1" />
      <path d="M 45 28 L 32 41 L 40 49 L 55 34 Z" fill="#54C5F8" />
      <path d="M 45 45 L 37 53 L 45 61 L 55 51 Z" fill="#0175C2" />
      
      <text x="82" y="30" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="700" fill="#FFFFFF">Building Clean Android</text>
      <text x="82" y="48" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="700" fill="#FFFFFF">Architecture with BLoC</text>
      <text x="82" y="66" font-family="'Segoe UI', Roboto, sans-serif" font-size="11" fill="#54C5F8">Mobile Dev • 25m ago</text>
    </g>

    <g transform="translate(36, 442)">
      <rect width="288" height="85" rx="14" fill="url(#feedCardGrad)" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" />
      <rect x="12" y="12" width="60" height="60" rx="10" fill="#14285b" stroke="rgba(255, 255, 255, 0.15)" stroke-width="1" />
      <circle cx="42" cy="42" r="14" fill="none" stroke="#54C5F8" stroke-width="2" />
      <circle cx="42" cy="42" r="5" fill="#54C5F8" />
      
      <text x="82" y="30" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="700" fill="#FFFFFF">Optimizing JSON &amp; Dio</text>
      <text x="82" y="48" font-family="'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="700" fill="#FFFFFF">Serializations in Dart</text>
      <text x="82" y="66" font-family="'Segoe UI', Roboto, sans-serif" font-size="11" fill="#8FA0C7">Backend &amp; API • 1h ago</text>
    </g>

    <g transform="translate(14, 550)">
      <rect width="332" height="60" fill="#09132d" />
      <line x1="0" y1="0" x2="332" y2="0" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />
      
      <circle cx="55" cy="24" r="5" fill="#54C5F8" />
      <text x="55" y="42" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" font-weight="700" fill="#54C5F8" text-anchor="middle">Feed</text>

      <circle cx="130" cy="24" r="5" fill="#8FA0C7" />
      <text x="130" y="42" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" fill="#8FA0C7" text-anchor="middle">Explore</text>

      <circle cx="205" cy="24" r="5" fill="#8FA0C7" />
      <text x="205" y="42" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" fill="#8FA0C7" text-anchor="middle">Saved</text>

      <circle cx="280" cy="24" r="5" fill="#8FA0C7" />
      <text x="280" y="42" font-family="'Segoe UI', Roboto, sans-serif" font-size="10" fill="#8FA0C7" text-anchor="middle">Profile</text>
    </g>
  </g>
</svg>
